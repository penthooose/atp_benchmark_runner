# ── Paths (relative → resolved from the project dir; override as needed) ────
TPTP_ROOT=./tmp/tptp
ATP_BENCHMARK_RUNNER_STORE_DIR=./tmp/atp_benchmark_runner_store
ATP_BENCHMARK_RUNNER_SMT_TMP_DIR=./tmp/smt_converted
ATP_BENCHMARK_RUNNER_SMT_THF_DIR=./tmp/thf_converted
ATP_BENCHMARK_RUNNER_SIF_DIR=./tmp/singularity_images
ATP_BENCHMARK_RUNNER_BUNDLED_EXAMPLES_DIR=./tmp/tptp_examples
ATP_BENCHMARK_RUNNER_USER_EXAMPLES_DIR=./tmp/tptp/user_examples
ATP_BENCHMARK_RUNNER_SINGLE_DOWNLOAD_DIR=./tmp/tptp

# ── HPC connection (used by HpcConnect.bootstrap/1) ─────────────────────────
HPC_CONNECT_CLUSTER=helma
HPC_CONNECT_USERNAME=your_username
HPC_CONNECT_IDENTITY_FILE=~/.ssh/id_hpc
HPC_CONNECT_PROXY_JUMP=csnhr.nhr.fau.de
HPC_CONNECT_WORK_DIR=$HOME/.cache/hpc_connect
HPC_CONNECT_VAULT_DIR=$HPCVAULT/.cache/hpc_connect
HPC_CONNECT_PORT_RANGE=8000:8999

# ── HPC benchmark defaults ──────────────────────────────────────────────────
ATP_BENCHMARK_RUNNER_HPC_MODE=single_node
ATP_BENCHMARK_RUNNER_HPC_SINGLE_NODE_MODE=sequential
ATP_BENCHMARK_RUNNER_HPC_SINGLE_NODE_STRATEGY=direct_provers
ATP_BENCHMARK_RUNNER_HPC_PARTITION=cpu
ATP_BENCHMARK_RUNNER_HPC_NODE_KIND=cpu
ATP_BENCHMARK_RUNNER_HPC_WALLTIME=02:00:00
ATP_BENCHMARK_RUNNER_HPC_MAX_PARALLEL_JOBS=4
ATP_BENCHMARK_RUNNER_HPC_NTASKS=1
ATP_BENCHMARK_RUNNER_HPC_PREPARE_IMAGES=false

# ── Optional ────────────────────────────────────────────────────────────────
ATP_BENCHMARK_RUNNER_HPC_NODE_SIZE=full

# ── SSH robustness (keep ON; off → gateway throttling stalls runs) ──────────
HPC_CONNECT_STEADY_CONNECTION=true
HPC_CONNECT_STEADY_TIMEOUT_SECONDS=30
HPC_CONNECT_RETRY_FOREVER=true

# ── Secrets ─────────────────────────────────────────────────────────────────
# HuggingFace Hub API token (required for gated/private model downloads).
HUGGINGFACE_HUB_TOKEN=hf_your_token_here