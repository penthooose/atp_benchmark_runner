# ── TPTP problem library ──────────────────────────────────────────────────────
# Directory where the TPTP problem library is stored (local files, bundled
# examples, or extracted official archive). Defaults to <store_dir>/tptp.
TPTP_ROOT=./tmp/tptp_problems

# Directory base for individually downloaded TPTP problems when using
# `AtpBenchmarkRunner.download_tptp_problems/2` (single problems instead of the
# full archive). Files are written in the archive layout below this base:
#   <base>/Problems/<DOMAIN>/<NAME>.p   and   <base>/Axioms/<DOMAIN>/<NAME>.ax
# Defaults to <TPTP_ROOT>, so downloads land at the exact paths an unpacked
# archive would produce (<TPTP_ROOT>/Problems/GRP/GRP001-1.p).
# ATP_BENCHMARK_RUNNER_SINGLE_DOWNLOAD_DIR=./tmp/tptp_problems

# ── Store / artifact directory ────────────────────────────────────────────────
# Where run manifests (.run.json), results (.results.json), reports
# (.report.json), and the local DETS database (.dets) are persisted.
# ATP_BENCHMARK_RUNNER_CACHE_DIR is used as fallback for backward compat.
# Defaults to ~/.cache/atp_benchmark_runner.
ATP_BENCHMARK_RUNNER_STORE_DIR=./tmp/atp_benchmark_runner_store

# Cache directory fallback
# Only used when ATP_BENCHMARK_RUNNER_STORE_DIR is not set. Also used by the
# Livebook Kino UI for caching form selections and panels.
ATP_BENCHMARK_RUNNER_CACHE_DIR=./tmp/atp_benchmark_runner_cache
LIVEBOOK_ATP_BENCHMARK_CACHE_DIR=./tmp/atp_benchmark_runner_livebook_cache

# TPTP-to-SMT temporary directory
# Where TPTP→SMT-LIB converted files are written before being mounted into
# Docker/Podman containers for provers like CVC5. Defaults to <system_tmp>/atp_smt_converted.

# ATP_BENCHMARK_RUNNER_SMT_TMP_DIR=./tmp/atp_smt_converted

# Optional
# ATP_BENCHMARK_RUNNER_ENV_FILE=.env

# HPC session defaults used by `HpcConnect.Session.local/1` when running the
# benchmark runner directly from this project.
HPC_CONNECT_CLUSTER=helma
HPC_CONNECT_SSH_ALIAS=helma
HPC_CONNECT_USERNAME=
HPC_CONNECT_IDENTITY_FILE=~/.ssh/id_fau_helma
HPC_CONNECT_PROXY_JUMP=csnhr.nhr.fau.de
HPC_CONNECT_WORK_DIR=$HOME/.cache/hpc_connect
HPC_CONNECT_VAULT_DIR=$HPCVAULT/.cache/hpc_connect

# Shared-node CPU benchmark defaults.
#
# NODE_SIZE controls CPU allocation:
#   full  → --exclusive with all node CPUs (Helma: 384, Fritz singlenode: 72, spr*: 104)
#   half  → no --exclusive, half the node's CPUs (Helma: 192, Fritz: 36/52)
#   Auto-detected per cluster; override any value below if needed.
ATP_BENCHMARK_RUNNER_HPC_MODE=single_node
ATP_BENCHMARK_RUNNER_HPC_SINGLE_NODE_MODE=sequential
ATP_BENCHMARK_RUNNER_HPC_SINGLE_NODE_STRATEGY=direct_provers
ATP_BENCHMARK_RUNNER_HPC_PARTITION=cpu
ATP_BENCHMARK_RUNNER_HPC_NODE_KIND=cpu
ATP_BENCHMARK_RUNNER_HPC_WALLTIME=02:00:00
ATP_BENCHMARK_RUNNER_HPC_MAX_PARALLEL_JOBS=4
# ATP_BENCHMARK_RUNNER_HPC_NODE_SIZE=full
# ATP_BENCHMARK_RUNNER_HPC_CPUS_PER_TASK=4      (explicit override, else derived from NODE_SIZE)
# ATP_BENCHMARK_RUNNER_HPC_EXCLUSIVE=false       (deprecated — use NODE_SIZE instead)
ATP_BENCHMARK_RUNNER_HPC_NTASKS=1
ATP_BENCHMARK_RUNNER_HPC_PREPARE_IMAGES=false

# HF_TOKEN=

# Steady OS SSH connection (inherited by hpc_connect sessions).
# When true, ssh commands multiplex over one persistent `ssh <target> "bash -s"`
# shell (no per-command handshake), with auto-reconnect on failure and
# exponential backoff retries. Works on all platforms (including Windows).
# HPC_CONNECT_STEADY_CONNECTION=false
# HPC_CONNECT_STEADY_TIMEOUT_SECONDS=30