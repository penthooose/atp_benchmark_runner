# Local ATP Benchmark

```elixir
Mix.install([
  {:kino, "~> 0.19"},
  {:table, "0.1.2"},
  {:atp_benchmark_runner, path: "item_14_ATP_Benchmark_Runner/atp_benchmark_runner", force: true}
])
```

## 1. Detect available execution methods

```elixir
avail = AtpBenchmarkRunner.LocalRunner.detect_available()
```

## 2. Pre-build Docker images

Missing images are also automatically built / pulled when `auto_ensure_images: true` is
set in step 6.

```elixir
build_provers = [:eprover, :vampire, :cvc5, :zipperposition, :leo3]

IO.puts("Pre-building Docker images for: #{inspect(build_provers)}")
Enum.each(build_provers, fn name ->
  case AtpBenchmarkRunner.LocalRunner.docker_image_status(name) do
    :available -> IO.puts("  #{name} already available")
    _ ->
      try do
        IO.puts(" #{name}...")
        AtpBenchmarkRunner.LocalRunner.ensure_docker_image!(name)
      rescue
        e -> IO.puts("  #{String.slice(Exception.message(e), 0, 200)}")
      end
  end
end)
```

---

## 3. Install bundled TPTP test examples

```elixir
tptp_root =
  AtpBenchmarkRunner.Config.tptp_dir(
    tptp_dir: Path.expand("./tmp/benchmark_tptp", __DIR__)
  )

IO.puts("TPTP root: #{tptp_root}")

paths = AtpBenchmarkRunner.install_tptp_examples!(
  root_dir: tptp_root,
  force: true
)

IO.puts("Installed #{length(paths)} example problems:")
Enum.each(paths, &IO.puts("  - #{&1}"))
```

---

## 4. Load problems and inspect metadata

```elixir
problems =
  AtpBenchmarkRunner.load_tptp_problems(
    root_dir: tptp_root,
    limit: 10
  )

IO.puts("Loaded #{length(problems)} problem(s):\n")

header = "| Name | Logic | Rating | Expected |"
sep    = "|------|-------|--------|----------|"

IO.puts(header)
IO.puts(sep)

Enum.each(problems, fn p ->
  IO.puts("| #{p.name} | #{p.logic || "?"} | #{p.rating} | #{p.expected_status || "?"} |")
end)
```

---

## 5. Select provers for local execution

```elixir
selected_provers = [
  # :tableaux,
  :eprover,
  :vampire,
  :cvc5,
  :zipperposition,
  :leo3,
  # :leo2,
  # :lash
]

IO.puts("Selected #{length(selected_provers)} prover(s):")
Enum.each(selected_provers, fn name ->
  IO.puts("  - #{AtpBenchmarkRunner.Prover.builtin!(name).label}")
end)
```

---

## 6. Bootstrap & run benchmark

`bootstrap/3` creates a plan (`Run` struct). `run_benchmark/1` executes it.

```elixir
plan = AtpBenchmarkRunner.bootstrap(selected_provers, problems,
  mode: :local,
  timeout_seconds: 120,
  auto_ensure_images: true
)

results = AtpBenchmarkRunner.run_benchmark(plan)
```

HPC mode stub

```elixir
# session = HpcConnect.Session.local()
# plan = AtpBenchmarkRunner.bootstrap(session, selected_provers, problems,
#   mode: :hpc,
#   hpc_mode: :single_node,  # or :multi_node
#   timeout_seconds: 120
# )
# results = AtpBenchmarkRunner.run_benchmark(plan)
```

---

## 7. Prover Results

```elixir
AtpBenchmarkRunner.results_table(results)
```

### Full details with proofs

```elixir
AtpBenchmarkRunner.explain_full(results) |> IO.puts()
```

### Filter by prover

```elixir
target_prover = :leo3

AtpBenchmarkRunner.verbose_report(results, prover: target_prover, solved_only: true)
|> Enum.each(&IO.puts/1)
```

### View a full proof

```elixir
AtpBenchmarkRunner.show_proof(results, :vampire, "GRP001-0")
```

### Raw Prover Debug Output

```elixir
target_prover = :vampire
target_problem = "GRP001-0"

result = Enum.find(results, fn r ->
  r.prover == target_prover and r.problem_id == target_problem
end)

if result && result.raw_output do
  IO.puts("Raw output for #{result.problem_id} / #{result.prover}:")
  IO.puts("")
  IO.puts(result.raw_output)
else
  IO.puts("Result not found or no raw output stored (rerun with include_raw_output: true)")
end
```

---

## 9. Aggregated report

```elixir
report = AtpBenchmarkRunner.report(results)

IO.puts("Run ID: #{report.run_id}")
IO.puts("Generated: #{report.generated_at}\n")
IO.puts(report.markdown)
```

### Per-prover breakdown

```elixir
AtpBenchmarkRunner.print_per_prover(report)
```

### Per-problem comparison

```elixir
AtpBenchmarkRunner.print_per_problem(report)
```

---

## 10. Persist results to local store

```elixir
run = AtpBenchmarkRunner.new_run(
  title: "Local smoke test",
  problems: problems,
  provers: selected_provers,
  walltime: "00:30:00",
  problem_timeout_seconds: 30
)

run_path = AtpBenchmarkRunner.save_run!(run)
IO.puts("Run saved: #{run_path}")

results_path = AtpBenchmarkRunner.save_results!(run, results)
IO.puts("Results saved: #{results_path}")

report_path = AtpBenchmarkRunner.save_report!(run, report)
IO.puts("Report saved: #{report_path}")
```

---

## 11. Compare with a previous run (longitudinal diff)

```elixir
prev_results_path = nil

if prev_results_path && File.exists?(prev_results_path) do
  prev_results = AtpBenchmarkRunner.Store.load_results!(prev_results_path)
  diff = AtpBenchmarkRunner.compare_runs(prev_results, results)
  IO.puts(AtpBenchmarkRunner.diff_markdown(diff))
else
  IO.puts("No previous results to compare against")
end
```
