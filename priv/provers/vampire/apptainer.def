Bootstrap: docker
From: alpine:latest

%labels
    Maintainer AISE Bamberg
    Prover Vampire
    Source https://github.com/vprover/vampire

%post
    set -eux
    # apk does not use setgroups/privilege-dropping like apt-get, so it works
    # on FAU compute nodes where user namespaces are restricted.
    apk add --no-cache curl ca-certificates jq unzip gcompat libstdc++
    arch="$(uname -m)"
    case "$arch" in
      x86_64|amd64) asset_pattern='Linux-X64' ;;
      aarch64|arm64) asset_pattern='Linux-ARM64' ;;
      *) asset_pattern='Linux' ;;
    esac
    curl -fsSL https://api.github.com/repos/vprover/vampire/releases/latest -o /tmp/vampire_release.json
    url="$(jq -r '.assets[].browser_download_url' /tmp/vampire_release.json \
      | grep -Ei "$asset_pattern" | grep -Evi 'sha|sig|asc' | head -1 || true)"
    if [ -z "$url" ]; then
      echo "Could not auto-detect a Vampire release binary." >&2
      exit 1
    fi
    curl -fL "$url" -o /tmp/vampire.asset
    unzip -o /tmp/vampire.asset -d /tmp/vampire_extract
    found="$(find /tmp/vampire_extract -type f -name vampire | head -1)"
    if [ -n "$found" ]; then
      install -m 0755 "$found" /usr/local/bin/vampire
    else
      # Fallback: first executable file in the zip
      found="$(find /tmp/vampire_extract -type f -executable | head -1)"
      [ -n "$found" ]
      install -m 0755 "$found" /usr/local/bin/vampire
    fi
    /usr/local/bin/vampire --version
    rm -rf /tmp/vampire_release.json /tmp/vampire.asset /tmp/vampire_extract

%runscript
    exec vampire "$@"
