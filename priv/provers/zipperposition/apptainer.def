Bootstrap: docker
From: ocaml/opam:ubuntu-22.04-ocaml-4.12

%labels
    Maintainer AISE Bamberg
    Prover Zipperposition
    Source https://github.com/sneeuwballen/zipperposition

%post
    set -eux
    # Proxy for FAU compute node internet access (Fritz, Helma, etc.)
    export HTTP_PROXY="http://proxy.nhr.fau.de:80"
    export HTTPS_PROXY="http://proxy.nhr.fau.de:80"
    export NO_PROXY="localhost,127.0.0.1,::1,10.0.0.0/8,.nhr.fau.de"
    export http_proxy="$HTTP_PROXY"
    export https_proxy="$HTTPS_PROXY"
    export no_proxy="$NO_PROXY"

    # OCI extraction already provides OCaml 4.12, opam, gcc, make, git, etc.
    # No apt-get needed in %post — avoids setgroups/chown on FAU nodes.

    # Use the image's pre-configured opam root (OCaml 4.12) if available;
    # otherwise init with the explicit compiler version to avoid downloading
    # the latest OCaml (5.x) which breaks zipperposition's oseq dependency.
    if [ -d /home/opam/.opam ]; then
      export OPAMROOT=/home/opam/.opam
    else
      export OPAMROOT=/root/.opam
      opam init --disable-sandboxing --compiler=ocaml-base-compiler.4.12.1 2>&1
    fi
    eval $(opam env)

    # pkgconf bootstrap: opam's conf-pkg-config depext tries `apt-get`, which
    # fails on FAU nodes (setgroups/setegid blocked in the user namespace).
    # Compiling pkgconf from source keeps `opam install --no-depext` working.
    cd /tmp && \
    curl -fSL "https://distfiles.ariadne.space/pkgconf/pkgconf-1.9.5.tar.gz" -o pkgconf.tar.gz && \
    tar --no-same-owner -xzf pkgconf.tar.gz && \
    cd pkgconf-1.9.5 && \
    ./configure --prefix=/usr/local && \
    make -j$(nproc) && \
    make install && \
    ln -sf /usr/local/bin/pkgconf /usr/local/bin/pkg-config && \
    ldconfig -n /usr/local/lib 2>/dev/null || true && \
    pkg-config --version
    cd / && rm -rf /tmp/pkgconf-1.9.5 /tmp/pkgconf.tar.gz

    opam update 2>&1 | tail -3
    # --no-depext: do not run system depext commands (apt-get) — the required
    # pkg-config is bootstrapped above. This is what previously made
    # `opam install zipperposition` fail silently and leave the image without
    # the binary ("executable file not found in $PATH" at runtime).
    opam install -y --no-depext zipperposition 2>&1 || \
      opam install -y --no-depext zipperposition.2.0 2>&1 || \
      echo "WARNING: Could not install zipperposition via opam" >&2
    # Search for the binary (check both possible opam roots), including the
    # switch's bin dir. -maxdepth 4 misses /home/opam/.opam/4.12/bin/zipperposition
    # (depth 6), so use a depth-free search plus `opam exec -- which`.
    found=""
    found="$(opam exec -- which zipperposition 2>/dev/null || true)"
    if [ -z "$found" ]; then
      for dir in /home/opam/.opam /root/.opam; do
        found="$(find "$dir" -type f -name zipperposition 2>/dev/null | head -1)"
        if [ -n "$found" ]; then break; fi
      done
    fi
    if [ -n "$found" ]; then
      ln -sf "$found" /usr/local/bin/zipperposition
      echo "Linked zipperposition from $found"
    else
      echo "WARNING: zipperposition binary not found after opam install" >&2
      # Fallback: try the known installed locations directly
      for candidate in /home/opam/.opam/4.12/bin/zipperposition /root/.opam/4.12/bin/zipperposition; do
        if [ -f "$candidate" ]; then
          ln -sf "$candidate" /usr/local/bin/zipperposition
          echo "Linked zipperposition from fallback path $candidate"
          found="$candidate"
          break
        fi
      done
    fi
    if [ -n "$found" ]; then
      /usr/local/bin/zipperposition --help >/dev/null 2>&1 && echo "zipperposition --help: OK" || true
    else
      echo "FATAL: zipperposition is not installed in this image — the benchmark will fail." >&2
      exit 1
    fi

%environment
    export OPAMROOT=/home/opam/.opam
    export PATH=/usr/local/bin:/home/opam/.opam/4.12/bin:$PATH

%runscript
    exec zipperposition "$@"
