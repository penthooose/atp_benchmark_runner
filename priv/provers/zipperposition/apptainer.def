Bootstrap: docker
From: ocaml/opam:ubuntu-22.04-ocaml-4.12

%labels
    Maintainer AISE Bamberg
    Prover Zipperposition
    Source https://github.com/sneeuwballen/zipperposition

%post
    set -eux
    # Proxy for FAU compute node internet access (Fritz, Helma, etc.)
    export HTTP_PROXY="http://proxy.nhr.fau.de:80"
    export HTTPS_PROXY="http://proxy.nhr.fau.de:80"
    export NO_PROXY="localhost,127.0.0.1,::1,10.0.0.0/8,.nhr.fau.de"
    export http_proxy="$HTTP_PROXY"
    export https_proxy="$HTTPS_PROXY"
    export no_proxy="$NO_PROXY"

    # OCI extraction provides OCaml 4.12, opam, gcc, make, git; no apt-get in %post.

    # Use the image's pre-configured opam root (OCaml 4.12) if available;
    # otherwise init with the explicit compiler version (OCaml 5.x breaks
    # zipperposition's oseq dependency).
    if [ -d /home/opam/.opam ]; then
      export OPAMROOT=/home/opam/.opam
    else
      export OPAMROOT=/root/.opam
      opam init --disable-sandboxing --compiler=ocaml-base-compiler.4.12.1 2>&1
    fi
    eval $(opam env)

    # opam's conf-pkg-config depext runs apt-get, which fails on FAU nodes;
    # compile pkgconf from source so `opam install --no-depext` works.
    cd /tmp && \
    curl -fSL "https://distfiles.ariadne.space/pkgconf/pkgconf-1.9.5.tar.gz" -o pkgconf.tar.gz && \
    tar --no-same-owner -xzf pkgconf.tar.gz && \
    cd pkgconf-1.9.5 && \
    ./configure --prefix=/usr/local && \
    make -j$(nproc) && \
    make install && \
    ln -sf /usr/local/bin/pkgconf /usr/local/bin/pkg-config && \
    export LD_LIBRARY_PATH="/usr/local/lib:${LD_LIBRARY_PATH:-}" && \
    ldconfig -n /usr/local/lib 2>/dev/null || true && \
    pkg-config --version
    cd / && rm -rf /tmp/pkgconf-1.9.5 /tmp/pkgconf.tar.gz

    # logtk needs zarith, which needs libgmp; compile it from source only if
    # the base image does not already provide it.
    if ! { ls /usr/include/gmp.h /usr/include/x86_64-linux-gnu/gmp.h 2>/dev/null | grep -q . || ldconfig -p 2>/dev/null | grep -q 'libgmp.so'; }; then
      cd /tmp && \
      curl -fSL "https://ftp.gnu.org/gnu/gmp/gmp-6.3.0.tar.xz" -o gmp.tar.xz && \
      tar -xJf gmp.tar.xz && \
      cd gmp-6.3.0 && \
      ./configure --prefix=/usr/local && \
      make -j$(nproc) && \
      make install && \
      cd / && rm -rf /tmp/gmp-6.3.0 /tmp/gmp.tar.xz
    fi
    export CPPFLAGS="-I/usr/local/include ${CPPFLAGS:-}"
    export LDFLAGS="-L/usr/local/lib ${LDFLAGS:-}"
    export PKG_CONFIG_PATH="/usr/local/lib/pkgconfig:${PKG_CONFIG_PATH:-}"
    export OPAMYES=1

    # --no-depext skips system apt-get (pkg-config and gmp are bootstrapped
    # above); only opam >= 2.1 supports the flag. `opam update` is skipped: the
    # pinned repo already has zipperposition 2.0/2.1, and a refresh pulls a
    # menhir version it excludes.
    if opam --version | grep -Eq '^2\.[123]'; then
      opam install --no-depext zipperposition 2>&1 || \
        opam install --no-depext zipperposition.2.1 2>&1 || \
        opam install --no-depext zipperposition.2.0 2>&1 || \
        { echo "WARNING: Could not install zipperposition via opam" >&2; true; }
    else
      opam install zipperposition 2>&1 || \
        opam install zipperposition.2.1 2>&1 || \
        opam install zipperposition.2.0 2>&1 || \
        { echo "WARNING: Could not install zipperposition via opam" >&2; true; }
    fi
    # Locate the binary in either opam root and link it into /usr/local/bin.
    found=""
    found="$(opam exec -- which zipperposition 2>/dev/null || true)"
    if [ -z "$found" ]; then
      for dir in /home/opam/.opam /root/.opam; do
        found="$(find "$dir" -type f -name zipperposition 2>/dev/null | head -1)"
        if [ -n "$found" ]; then break; fi
      done
    fi
    if [ -n "$found" ]; then
      ln -sf "$found" /usr/local/bin/zipperposition
      echo "Linked zipperposition from $found"
    else
      echo "WARNING: zipperposition binary not found after opam install" >&2
      # Fallback: try the known installed locations directly
      for candidate in /home/opam/.opam/4.12/bin/zipperposition /root/.opam/4.12/bin/zipperposition; do
        if [ -f "$candidate" ]; then
          ln -sf "$candidate" /usr/local/bin/zipperposition
          echo "Linked zipperposition from fallback path $candidate"
          found="$candidate"
          break
        fi
      done
    fi
    if [ -n "$found" ]; then
      /usr/local/bin/zipperposition --help >/dev/null 2>&1 && echo "zipperposition --help: OK" || true
    else
      echo "FATAL: zipperposition is not installed in this image; the benchmark will fail." >&2
      exit 1
    fi

    # Relocate the opam switch to /opt/opam: the cluster bind-mounts the host
    # /home into every container, hiding the image's /home/opam at runtime and
    # dangling the /usr/local/bin/zipperposition symlink.
    mkdir -p /opt
    for src in /home/opam/.opam /root/.opam; do
      if [ -d "$src" ] && [ ! -d /opt/opam ]; then
        mv "$src" /opt/opam
      fi
    done
    if [ -d /opt/opam ]; then
      echo "Relocated opam switch to /opt/opam"
      zp_bin="$(ls -d /opt/opam/*/bin/zipperposition 2>/dev/null | head -1)"
      if [ -n "$zp_bin" ]; then
        ln -sfn "$zp_bin" /usr/local/bin/zipperposition
        echo "Re-pointed /usr/local/bin/zipperposition -> $zp_bin"
      fi
      # OCaml native binaries dlopen() their C stub libraries (dll*.so) at
      # runtime via CAML_LD_LIBRARY_PATH; also copy them into /usr/local/lib as
      # a fallback so the binary works even if that env var is not set.
      cp -n /opt/opam/*/lib/ocaml/stublibs/dll*.so /usr/local/lib/ 2>/dev/null || true
      cp -n /opt/opam/*/lib/ocaml/dll*.so /usr/local/lib/ 2>/dev/null || true
      ldconfig 2>/dev/null || true
    else
      echo "WARNING: no opam switch found to relocate" >&2
    fi

%environment
    export OPAMROOT=/opt/opam
    export PATH=/usr/local/bin:/opt/opam/4.12/bin:$PATH
    export CAML_LD_LIBRARY_PATH=/usr/local/lib:/opt/opam/4.12/lib/ocaml/stublibs
    export LD_LIBRARY_PATH=/usr/local/lib:/opt/opam/4.12/lib/stublibs:/opt/opam/4.12/lib/ocaml/stublibs:${LD_LIBRARY_PATH:-}

%runscript
    export CAML_LD_LIBRARY_PATH=/usr/local/lib:/opt/opam/4.12/lib/ocaml/stublibs
    export LD_LIBRARY_PATH=/usr/local/lib:/opt/opam/4.12/lib/stublibs:/opt/opam/4.12/lib/ocaml/stublibs:${LD_LIBRARY_PATH:-}
    exec zipperposition "$@"
