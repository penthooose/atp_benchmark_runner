# LEO-II container image (OCaml 4.12 opam-based build).
#   docker build -t docker.io/aise/atp-leo2:latest priv/provers/leo2/
#   docker run --rm docker.io/aise/atp-leo2:latest --timeout 30 /problems/problem.p
FROM docker.io/ocaml/opam:ubuntu-22.04-ocaml-4.12 AS builder

USER root
RUN apt-get update -qq && apt-get install -y -qq pkg-config m4 libpcre2-dev zlib1g-dev

# Set up opam env
ENV OPAMROOT=/home/opam/.opam
RUN rm -f /usr/share/opam/sandbox.sh 2>/dev/null || true
ENV OPAMYES=1
RUN eval $(opam env) && opam install -y ocamlfind camlp5 camlp4

# The official leo2_v1.7.0.tgz is now a Git LFS pointer, so the source is
# cloned from the archived GitHub repo instead (v1.7.0 = the same source).
RUN git clone --depth 1 --branch v1.7.0 https://github.com/leoprover/LEO-II.git /opt/leo2 2>/dev/null || \
    git clone --depth 1 https://github.com/leoprover/LEO-II.git /opt/leo2

WORKDIR /opt/leo2/src

# OCaml 4.12 bytes/string compat: drop the `module Bytes = String` alias and
# wrap read_file call sites to convert bytes to string.
RUN sed -i '/^module Bytes = String$/d' calculus/automation.ml && \
    sed -i 's/read_file file_out in/Bytes.to_string (read_file file_out) in/g' calculus/automation.ml

# Old MiniSat code needs -fpermissive under newer GCC.
RUN sed -i 's|cd ../lib/minisat;|cd ../lib/minisat; export CFLAGS="-Wall -Wno-parentheses -fPIC -fpermissive";|' Makefile && \
    sed -i 's|\$(CXX) -c -fPIC -Wall|\$(CXX) -c -fPIC -Wall -fpermissive|' Makefile

RUN eval $(opam env) && make && make opt

# Prefer the native leo.opt (self-contained) over the bytecode `leo`.
RUN candidate="$(find /opt/leo2 -type f -name 'leo.opt' | head -1)"; \
    if [ -z "$candidate" ]; then \
    candidate="$(find /opt/leo2 -type f \( -name 'leo' -o -name 'leo.opt' -o -name 'leo.byte' \) | head -1)"; \
    fi; \
    if [ -z "$candidate" ]; then \
    echo "LEO-II build failed" >&2; \
    exit 1; \
    fi; \
    cp "$candidate" /usr/local/bin/leo

# Runtime keeps the same ocaml/opam base so ocamlrun + shared libs stay valid.
FROM docker.io/ocaml/opam:ubuntu-22.04-ocaml-4.12
USER root
COPY --from=builder /usr/local/bin/leo /usr/local/bin/leo
# leo links against dllminisatinterface.so at build-time paths.
COPY --from=builder /opt/leo2/src/interfaces/minisat/dllminisatinterface.so /opt/leo2/src/interfaces/minisat/dllminisatinterface.so
# leo dlopen()s OCaml C stub libraries at runtime; point CAML_LD_LIBRARY_PATH
# at the copied stubs.
COPY --from=builder /home/opam/.opam/4.12/lib/ocaml/stublibs/dll*.so /usr/local/lib/
ENV CAML_LD_LIBRARY_PATH=/usr/local/lib
# LEO-II needs E-Prover as first-order backend; LEO-II 1.7.0 calls E with
# `-t <seconds>`, which E >= 2.x redefined, so E is pinned to 1.9.1.
RUN apt-get update -qq && apt-get install -y -qq ca-certificates git build-essential gawk make perl && rm -rf /var/lib/apt/lists/* && \
    git clone --depth 1 --branch E-1-9-1 https://github.com/eprover/eprover.git /opt/eprover && \
    cd /opt/eprover && \
    # E 1.9.1 defaults CC = gcc-4, which does not exist on Ubuntu 22.04.
    sed -i 's/^CC[[:space:]]*=[[:space:]]*gcc-4/CC = gcc/' Makefile.vars && \
    ./configure --bindir=/usr/local/bin && \
    make && make install && \
    rm -rf /opt/eprover
# leo needs the E backend path in its config (HOME=/root in the container).
RUN echo 'e = /usr/local/bin/eprover' > /root/.leoatprc && \
    echo 'e = /usr/local/bin/eprover' > /home/opam/.leoatprc && \
    chown opam:opam /home/opam/.leoatprc
ENTRYPOINT ["/usr/local/bin/leo"]
