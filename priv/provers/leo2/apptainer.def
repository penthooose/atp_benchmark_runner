Bootstrap: docker
From: ocaml/opam:ubuntu-22.04-ocaml-4.12

%labels
    Maintainer AISE Bamberg
    Prover LEO-II
    Source http://page.mi.fu-berlin.de/cbenzmueller/leo/download.html

%post
    set -eux
    # Proxy for FAU compute node internet access (Fritz, Helma, etc.)
    export HTTP_PROXY="http://proxy.nhr.fau.de:80"
    export HTTPS_PROXY="http://proxy.nhr.fau.de:80"
    export NO_PROXY="localhost,127.0.0.1,::1,10.0.0.0/8,.nhr.fau.de"
    export http_proxy="$HTTP_PROXY"
    export https_proxy="$HTTPS_PROXY"
    export no_proxy="$NO_PROXY"

    # Reset PATH: Apptainer can strip it between stages and opam sub-processes
    # inherit a restricted PATH.
    export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    hash -r

    # apt-get is unavailable on FAU nodes, so the system deps opam guards need
    # (m4, pkgconf, pcre2, zlib) are compiled from source.
    curl -fsSL "https://ftp.gnu.org/gnu/m4/m4-1.4.19.tar.gz" -o /tmp/m4-src.tar.gz 2>/dev/null || true
    if [ -f /tmp/m4-src.tar.gz ] && [ -s /tmp/m4-src.tar.gz ]; then
      tar --no-same-owner -xzf /tmp/m4-src.tar.gz -C /tmp
      cd /tmp/m4-1.4.19
      ./configure --prefix=/usr/local --quiet 2>/dev/null
      make -j$(nproc) 2>/dev/null
      make install 2>/dev/null
      cd /
      rm -rf /tmp/m4-1.4.19 /tmp/m4-src.tar.gz
      hash -r
    fi
    # opam's conf-pkg-config needs pkgconf; compiled from source (see above).
    cd /tmp && \
    curl -fSL "https://distfiles.ariadne.space/pkgconf/pkgconf-1.9.5.tar.gz" -o pkgconf.tar.gz && \
    tar --no-same-owner -xzf pkgconf.tar.gz && \
    cd pkgconf-1.9.5 && \
    ./configure --prefix=/usr/local && \
    make -j$(nproc) && \
    make install && \
    ln -sf /usr/local/bin/pkgconf /usr/local/bin/pkg-config && \
    export PATH="/usr/local/bin:$PATH" && \
    export LD_LIBRARY_PATH="/usr/local/lib:${LD_LIBRARY_PATH:-}" && \
    hash -r && \
    ldconfig -n /usr/local/lib 2>/dev/null || true && \
    pkg-config --version

    # Verify pkg-config is on PATH.
    PKG_PATH="$(command -v pkg-config 2>/dev/null || echo MISSING)"
    echo "pkg-config binary at: $PKG_PATH"
    if [ "$PKG_PATH" = "MISSING" ]; then
      echo "FATAL: pkg-config not found after pkgconf install" >&2
      ls -la /usr/local/bin/pkgconf /usr/local/bin/pkg-config 2>&1 || true
      exit 1
    fi

    # Extra /usr/bin symlink so opam sub-processes find pkg-config regardless
    # of PATH.
    ln -sf /usr/local/bin/pkgconf /usr/bin/pkg-config 2>/dev/null || true
    ls -la /usr/bin/pkg-config 2>/dev/null && /usr/bin/pkg-config --version || true

    cd / && rm -rf /tmp/pkgconf-1.9.5 /tmp/pkgconf.tar.gz

    # camlp5 pulls in pcre2 (via pkg-config); compiled from source (see above).
    cd /tmp && \
    curl -fSL "https://github.com/PCRE2Project/pcre2/releases/download/pcre2-10.42/pcre2-10.42.tar.gz" -o pcre2.tar.gz && \
    tar --no-same-owner -xzf pcre2.tar.gz && \
    cd pcre2-10.42 && \
    ./configure --prefix=/usr/local && \
    make -j$(nproc) && \
    make install && \
    export PKG_CONFIG_PATH="/usr/local/lib/pkgconfig:${PKG_CONFIG_PATH:-}" && \
    ldconfig -n /usr/local/lib 2>/dev/null || true && \
    pkg-config --exists libpcre2-8 && \
    echo "PCRE2 check: $(pkg-config --modversion libpcre2-8)"

    cd / && rm -rf /tmp/pcre2-10.42 /tmp/pcre2.tar.gz

    # MiniSat (bundled with LEO-II) needs zlib.h; compiled from source.
    cd /tmp && \
    curl -fSL "https://github.com/madler/zlib/archive/refs/tags/v1.3.1.tar.gz" -o zlib.tar.gz && \
    tar --no-same-owner -xzf zlib.tar.gz && \
    cd zlib-1.3.1 && \
    ./configure --prefix=/usr/local && \
    make -j$(nproc) && \
    make install && \
    hash -r && \
    cd / && rm -rf /tmp/zlib-1.3.1 /tmp/zlib.tar.gz

    # Use the image's pre-configured opam root (OCaml 4.12) if available;
    # otherwise init with the explicit compiler version.
    if [ -d /home/opam/.opam ]; then
      export OPAMROOT=/home/opam/.opam
      # Disable opam sandboxing so conf-pkg-config inherits PATH with our
      # source-built pkg-config.
      rm -f /usr/share/opam/sandbox.sh 2>/dev/null || true
    else
      export OPAMROOT=/root/.opam
      opam init --disable-sandboxing --compiler=ocaml-base-compiler.4.12.1 2>&1
    fi
    eval $(opam env)

    # Force opam env vars so sub-process builds inherit PATH.
    export OPAMENV_IGNORE=false
    export OPAMROOTISOK=1
    export OPAMYES=1
    export PATH="/usr/local/bin:$PATH"
    export PKG_CONFIG_PATH="/usr/local/lib/pkgconfig:${PKG_CONFIG_PATH:-}"
    hash -r

    # Final check before opam install: confirm pkg-config is findable
    echo "Pre-opam pkg-config check: $(command -v pkg-config 2>/dev/null || echo MISSING)"

    # ocamlfind, camlp5 and camlp4 via opam (LEO-II's Makefile needs camlp4o.opt).
    opam install -y ocamlfind camlp5 camlp4

    # The official leo2_v1.7.0.tgz is now a Git LFS pointer, so the source is
    # cloned from the archived GitHub repo instead (v1.7.0 = the same source).
    rm -rf /opt/leo2
    git clone --depth 1 --branch v1.7.0 https://github.com/leoprover/LEO-II.git /opt/leo2 2>/dev/null || \
      git clone --depth 1 https://github.com/leoprover/LEO-II.git /opt/leo2
    # Makefile is in src/, not at top level
    cd /opt/leo2/src
    # Drop the repo's `module Bytes = String` alias (OCaml 4.12 compat) and wrap
    # read_file call sites to convert bytes to string.
    sed -i '/^module Bytes = String$/d' calculus/automation.ml
    sed -i 's/read_file file_out in/Bytes.to_string (read_file file_out) in/g' calculus/automation.ml
    # Old MiniSat code needs -fpermissive under newer GCC.
    sed -i 's|cd ../lib/minisat;|cd ../lib/minisat; export CFLAGS="-Wall -Wno-parentheses -fPIC -fpermissive";|' Makefile
    sed -i 's|\$(CXX) -c -fPIC -Wall|\$(CXX) -c -fPIC -Wall -fpermissive|' Makefile
    make || true
    # Prefer the native leo.opt: the bytecode `leo` has an ocamlrun shebang that
    # dangles at runtime (the cluster hides /home/opam).
    make opt || true
    candidate="$(find /opt/leo2 -type f -name 'leo.opt' | head -1 || true)"
    if [ -z "$candidate" ]; then
      candidate="$(find /opt/leo2 -type f \( -name 'leo' -o -name 'leo.opt' -o -name 'leo.byte' \) | head -1 || true)"
    fi
    if [ -z "$candidate" ]; then
      echo "LEO-II legacy build did not produce a binary." >&2
      exit 1
    fi
    install -m 0755 "$candidate" /usr/local/bin/leo
    /usr/local/bin/leo -h >/dev/null || true

    # LEO-II needs E-Prover as first-order backend; LEO-II 1.7.0 calls E with
    # `-t <seconds>`, which E >= 2.x redefined, so E is pinned to 1.9.1.
    # E 1.9.1 defaults CC = gcc-4, which does not exist on Ubuntu 22.04.
    git clone --depth 1 --branch E-1-9-1 https://github.com/eprover/eprover.git /opt/eprover
    cd /opt/eprover
    sed -i 's/^CC[[:space:]]*=[[:space:]]*gcc-4/CC = gcc/' Makefile.vars
    ./configure --bindir=/usr/local/bin
    make
    make install 2>/dev/null || true
    if [ ! -x /usr/local/bin/eprover ] && [ -x PROVER/eprover ]; then
      install -m 0755 PROVER/eprover /usr/local/bin/eprover
    fi
    if [ -x /usr/local/bin/eprover ]; then
      /usr/local/bin/eprover --version
    else
      echo "WARNING: eprover binary not found after build" >&2
    fi
    rm -rf /opt/eprover

    # Create ATP config so Leo2 can find E-Prover at runtime
    mkdir -p /home/opam
    echo 'e = /usr/local/bin/eprover' > /home/opam/.leoatprc

    # Targeted cleanup only; avoid rm -rf /tmp/* which can hit mounted dirs.
    rm -rf /opt/leo2 2>/dev/null || true

    # Copy the .so files leo references (outside standard loader dirs) into
    # /usr/local/lib so the image works without extra LD_LIBRARY_PATH.
    mkdir -p /usr/local/lib
    for f in $(ldd /usr/local/bin/leo 2>/dev/null | awk '/=>/ {print $3}' | grep -Ev '^/(lib|lib64|usr/lib|usr/lib64)/' | sort -u); do
      if [ -n "$f" ] && [ -f "$f" ]; then
        cp -n "$f" /usr/local/lib/ 2>/dev/null || true
      fi
    done
    ldconfig 2>/dev/null || true
    ldd /usr/local/bin/leo 2>/dev/null | head -20 || true

    # Relocate the opam switch to /opt/opam: the cluster bind-mounts the host
    # /home into every container, hiding the image's /home/opam at runtime and
    # breaking leo.opt's dlopen() of its C stub libraries.
    mkdir -p /opt
    for src in /home/opam/.opam /root/.opam; do
      if [ -d "$src" ] && [ ! -d /opt/opam ]; then
        mv "$src" /opt/opam
      fi
    done
    if [ -d /opt/opam ]; then
      echo "Relocated opam switch to /opt/opam"
      cp -n /opt/opam/*/lib/ocaml/stublibs/dll*.so /usr/local/lib/ 2>/dev/null || true
      cp -n /opt/opam/*/lib/ocaml/dll*.so /usr/local/lib/ 2>/dev/null || true
      ldconfig 2>/dev/null || true
    else
      echo "WARNING: no opam switch found to relocate" >&2
    fi

%environment
    export OPAMROOT=/opt/opam
    export PATH=/usr/local/bin:/opt/opam/4.12/bin:/usr/bin:/bin:$PATH
    export CAML_LD_LIBRARY_PATH=/usr/local/lib:/opt/opam/4.12/lib/ocaml/stublibs
    export LD_LIBRARY_PATH=/usr/local/lib:/opt/opam/4.12/lib/ocaml/stublibs:/opt/opam/4.12/lib/ocaml:/usr/lib/x86_64-linux-gnu:${LD_LIBRARY_PATH:-}

%runscript
    export CAML_LD_LIBRARY_PATH=/usr/local/lib:/opt/opam/4.12/lib/ocaml/stublibs
    export LD_LIBRARY_PATH=/usr/local/lib:/opt/opam/4.12/lib/ocaml/stublibs:/opt/opam/4.12/lib/ocaml:/usr/lib/x86_64-linux-gnu:${LD_LIBRARY_PATH:-}
    exec leo "$@"

%help
    LEO-II is a cooperative higher-order prover that requires an external
    first-order ATP backend (E-Prover) to close proofs. This image has
    E-Prover built from source and a .leoatprc config pointing to it.

    Use via the benchmark runner (recommended):
      leo --atp e=/usr/local/bin/eprover -po 1 -f e -at <atp_timeout> -t <timeout_seconds> <problem.p>

    Flags:
      --atp e=EXEC    Bind prover "e" to an executable (overrides .leoatprc)
      -po 1           Proof output (SZS status)
      -f e            Select E-Prover as first-order backend
      -at N           ATP timeout in seconds (passed to E-Prover)
      -t N            Leo2 own timeout in seconds

    The opam switch lives at /opt/opam (relocated from /home/opam/.opam, which
    is hidden at runtime by the cluster's host /home bind mount). E-Prover is
    installed at /usr/local/bin/eprover.
