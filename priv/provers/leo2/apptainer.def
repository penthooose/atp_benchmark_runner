Bootstrap: docker
From: ubuntu:20.04

%labels
    Maintainer AISE Bamberg
    Prover LEO-II
    Source http://page.mi.fu-berlin.de/cbenzmueller/leo/download.html

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends ca-certificates curl build-essential make ocaml ocaml-findlib camlp5
    curl -fL http://page.mi.fu-berlin.de/cbenzmueller/leo/leo2_v1.7.0.tgz -o /tmp/leo2.tgz
    mkdir -p /opt/leo2
    tar -xzf /tmp/leo2.tgz -C /opt/leo2 --strip-components=1
    cd /opt/leo2
    make || true
    candidate="$(find /opt/leo2 -type f \( -name 'leo' -o -name 'leo.opt' -o -name 'leo.byte' \) | head -1 || true)"
    if [ -z "$candidate" ]; then
      echo "LEO-II legacy build did not produce a binary. This definition may need project-specific patching." >&2
      exit 1
    fi
    install -m 0755 "$candidate" /usr/local/bin/leo
    leo -h >/dev/null || true
    apt-get clean
    rm -rf /var/lib/apt/lists/* /tmp/*

%runscript
    exec leo "$@"
