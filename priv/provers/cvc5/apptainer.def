Bootstrap: docker
From: alpine:latest

%labels
    Maintainer AISE Bamberg
    Prover cvc5
    Source https://github.com/cvc5/cvc5

%post
    set -eux
    export HTTP_PROXY="http://proxy.nhr.fau.de:80"
    export HTTPS_PROXY="http://proxy.nhr.fau.de:80"
    export NO_PROXY="localhost,127.0.0.1,::1,10.0.0.0/8,.nhr.fau.de"
    export http_proxy="$HTTP_PROXY"
    export https_proxy="$HTTPS_PROXY"
    export no_proxy="$NO_PROXY"

    apk add --no-cache curl ca-certificates jq unzip git build-base cmake python3 gmp-dev bash

    rm -rf /tmp/cvc5
    cd /tmp
    git clone https://github.com/cvc5/cvc5.git
    cd cvc5

    ./configure.sh --auto-download

    cd build
    make -j$(nproc)
    make install

    /usr/local/bin/cvc5 --version
    /usr/local/bin/cvc5 --lang help || true

    rm -rf /tmp/cvc5

%runscript
    exec cvc5 "$@"