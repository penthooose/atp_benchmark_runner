# Lash container image (with tptp4X).
#
# Includes tptp4X (with JJParser) for TPTP syntax normalization and a
# fof2thf Python wrapper for FOF/CNF/TFF → THF type promotion.
#
#   docker build -t docker.io/aise/atp-lash:latest priv/provers/lash/
#   docker run --rm docker.io/aise/atp-lash:latest /problems/problem.p
ARG LASH_URL=http://grid01.ciirc.cvut.cz/~chad/lash/lash-1.14.tgz

# Builder stage (lash + tptp4X)
FROM docker.io/ocaml/opam:ubuntu-22.04-ocaml-4.12 AS builder
ARG LASH_URL

USER root
RUN apt-get update -qq && apt-get install -y -qq \
    pkg-config m4 libpcre2-dev zlib1g-dev libcurl4-openssl-dev git

# Build lash
ENV OPAMROOT=/home/opam/.opam
RUN rm -f /usr/share/opam/sandbox.sh 2>/dev/null || true
ENV OPAMYES=1

RUN mkdir -p /opt/lash && \
    curl -fSL "${LASH_URL}" -o /tmp/lash.tar.gz && \
    tar -xzf /tmp/lash.tar.gz -C /opt/lash --strip-components=1

WORKDIR /opt/lash/source
ENV C_INCLUDE_PATH=/home/opam/.opam/4.12/lib/ocaml
ENV CPLUS_INCLUDE_PATH=/home/opam/.opam/4.12/lib/ocaml

RUN eval $(opam env) && \
    ./configure && \
    SOLVER_CC="$(find /opt/lash -name 'Solver.cc' -type f 2>/dev/null | head -1)" && \
    if [ -n "$SOLVER_CC" ]; then \
    sed -i 's/caml_process_pending_signals\b/caml_process_pending_signals_exn/g' "$SOLVER_CC"; \
    fi && \
    OCAML_LIBDIR="$(ocamlc -where 2>/dev/null || echo /home/opam/.opam/4.12/lib/ocaml)" && \
    if [ -f "$OCAML_LIBDIR/libasmrun.a" ]; then \
    sed -i "s|-o lash|-o lash \"$OCAML_LIBDIR/libasmrun.a\"|" Makefile; \
    fi && \
    make -j$(nproc)

RUN candidate="$(find /opt/lash -maxdepth 4 -type f \( -name 'lash' -o -name 'lash.opt' -o -name 'lash.byte' \) | head -1)"; \
    if [ -z "$candidate" ]; then \
    echo "Lash build failed" >&2; \
    exit 1; \
    fi; \
    cp "$candidate" /usr/local/bin/lash

# Build tptp4X (with JJParser)
# JJParser is a sibling-directory symlink (../JJParser) in the TPTP4X tree.
# The Makefile handles -DTPTP_HOME quoting when TPTP_HOME is a make variable.
RUN git clone https://github.com/TPTPWorld/JJParser.git /tmp/JJParser && \
    git clone https://github.com/TPTPWorld/TPTP4X.git /tmp/tptp4X && \
    cd /tmp/tptp4X && \
    TPTP_HOME=/usr/local make CC=gcc LFLAGS="-lcurl -lm" && \
    cp tptp4X /usr/local/bin/tptp4X && \
    rm -rf /tmp/tptp4X /tmp/JJParser

# Runtime stage
FROM docker.io/ubuntu:22.04
RUN apt-get update -qq && apt-get install -y -qq \
    libgomp1 libpcre2-8-0 zlib1g libstdc++6 python3 libcurl4 && \
    rm -rf /var/lib/apt/lists/*
COPY --from=builder /usr/local/bin/lash /usr/local/bin/lash
COPY --from=builder /opt/lash/modes /opt/lash/modes
COPY --from=builder /usr/local/bin/tptp4X /usr/local/bin/tptp4X

# fof2thf: type-promotion script (Python)
RUN printf '%s\n' '#!/usr/bin/env python3' \
    'import re,sys' \
    'A=re.compile(r"\b([a-z_][a-zA-Z0-9_]*)\s*\(")' \
    'K={"fof","cnf","tff","thf","axiom","conjecture","type","and","or","not","impl","equiv","true","false","include"}' \
    'V=set("xyzuvw")' \
    'def scan(body):' \
    '  apps=set(A.findall(body))-K' \
    '  words=set(re.findall(r"\b([a-z_][a-zA-Z0-9_]*)\b",body))' \
    '  return apps, words-apps-K-V' \
    'c=sys.stdin.read()' \
    'all_apps=set(); all_bare=set()' \
    'for m in re.finditer(r"(?:fof|cnf|tff)\(\s*([^,]+?)\s*,\s*([^,]+?)\s*,\s*(.+?)\)\s*\.?\s*",c,re.DOTALL):' \
    '  a,b=scan(m.group(3)); all_apps|=a; all_bare|=b' \
    'decls="\n".join(sorted("thf(tp_"+s+", type, ("+s+": $o))." for s in all_bare if s not in all_apps))' \
    'c=re.sub(r"(^% SPC\s*:).*",r"\1 THF_THM_NEQ",c,flags=re.MULTILINE)' \
    'c=re.sub(r"\bfof\(","thf(",c)' \
    'c=re.sub(r"\bcnf\(","thf(",c)' \
    'c=re.sub(r"\btff\(","thf(",c)' \
    'if decls: c=re.sub(r"^(thf\(.*?\)\.)",decls+r"\n\1",c,count=1,flags=re.MULTILINE|re.DOTALL)' \
    'sys.stdout.write(c)' > /usr/local/bin/fof2thf
RUN chmod +x /usr/local/bin/fof2thf

# lash-wrapper: tptp4X normalize + fof2thf promote + lash solve
RUN printf '%s\n' '#!/bin/bash' \
    'set -Eeuo pipefail' \
    'ARGS=(); PROBLEM=""' \
    'while [[ $# -gt 0 ]]; do' \
    '  case "$1" in' \
    '    -t) ARGS+=("$1" "$2"); shift 2 ;;' \
    '    -M) ARGS+=("$1" "$2"); shift 2 ;;' \
    '    -*|--*) ARGS+=("$1"); shift ;;' \
    '    *) if [ -z "$PROBLEM" ] && [ -f "$1" ]; then PROBLEM="$1"; fi; ARGS+=("$1"); shift ;;' \
    '  esac' \
    'done' \
    'if [ -z "$PROBLEM" ]; then exec lash "${ARGS[@]}"; fi' \
    'TMP=$(mktemp /tmp/lash_norm_XXXXXX.p)' \
    'TMP2=$(mktemp /tmp/lash_thf_XXXXXX.p)' \
    'if tptp4X "$PROBLEM" > "$TMP" 2>/dev/null; then' \
    '  INPUT="$TMP"' \
    'else' \
    '  INPUT="$PROBLEM"' \
    'fi' \
    'if head -20 "$INPUT" 2>/dev/null | grep -qiE '"'"'^% SPC.*THF'"'"'; then' \
    '  exec lash "${ARGS[@]}"' \
    'fi' \
    'fof2thf < "$INPUT" > "$TMP2" 2>/dev/null || { rm -f "$TMP2" "$TMP"; echo "% SZS status Error" >&2; exit 1; }' \
    'FINAL_ARGS=(); FOUND=0' \
    'for arg in "${ARGS[@]}"; do' \
    '  if [ "$arg" = "$PROBLEM" ] && [ "$FOUND" = 0 ]; then FINAL_ARGS+=("$TMP2"); FOUND=1; else FINAL_ARGS+=("$arg"); fi' \
    'done' \
    'lash "${FINAL_ARGS[@]}"; RC=$?; rm -f "$TMP2" "$TMP"; exit $RC' > /usr/local/bin/lash-wrapper
RUN chmod +x /usr/local/bin/lash-wrapper
ENTRYPOINT ["lash-wrapper"]
