Bootstrap: docker
From: buildpack-deps:stable

%labels
    Maintainer AISE Bamberg
    Prover E-Prover
    Source https://github.com/eprover/eprover

%post
    set -eux
    # Proxy for FAU compute node internet access (Fritz, Helma, etc.)
    export HTTP_PROXY="http://proxy.nhr.fau.de:80"
    export HTTPS_PROXY="http://proxy.nhr.fau.de:80"
    export NO_PROXY="localhost,127.0.0.1,::1,10.0.0.0/8,.nhr.fau.de"
    export http_proxy="$HTTP_PROXY"
    export https_proxy="$HTTPS_PROXY"
    export no_proxy="$NO_PROXY"

    # buildpack-deps:stable ships gcc/g++/make/git/perl/curl; no package
    # manager in %post.

    git clone --depth 1 https://github.com/eprover/eprover.git /opt/eprover
    cd /opt/eprover
    ./configure --enable-ho --bindir=/usr/local/bin
    make rebuild
    make install
    # With --enable-ho, E builds 'eprover-ho'. Fall back to 'eprover' if HO binary missing.
    if [ -x /usr/local/bin/eprover-ho ]; then
      :  # installed by make install
    elif [ -x /opt/eprover/PROVER/eprover-ho ]; then
      cp /opt/eprover/PROVER/eprover-ho /usr/local/bin/eprover-ho
    elif [ -x /usr/local/bin/eprover ]; then
      ln -sf /usr/local/bin/eprover /usr/local/bin/eprover-ho
    elif [ -x /opt/eprover/PROVER/eprover ]; then
      cp /opt/eprover/PROVER/eprover /usr/local/bin/eprover
      ln -sf /usr/local/bin/eprover /usr/local/bin/eprover-ho
    fi
    if [ -x /usr/local/bin/eprover-ho ]; then
      /usr/local/bin/eprover-ho --version
    else
      echo "WARNING: eprover binary not found after build" >&2
      ls -la /usr/local/bin/ | grep -i epro || true
      ls -la /opt/eprover/PROVER/ | head -20 || true
    fi
    rm -rf /opt/eprover

%runscript
    exec eprover-ho "$@"
