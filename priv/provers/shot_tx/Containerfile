# ShotTx (Shot), higher-order (Church STT) tableau prover, Elixir escript build.
#   docker build -t docker.io/aise/atp-shot_tx:latest priv/provers/shot_tx/
#   docker run --rm docker.io/aise/atp-shot_tx:latest --szs -t 30000 /problems/problem.p
#
# ShotTx requires Elixir >= 1.20 (hence the 1.20.3 base image).
FROM docker.io/hexpm/elixir:1.20.3-erlang-28.4.3-debian-bookworm-20260824-slim AS builder

# Source repo: same one the Apptainer .def uses.
ARG SHOT_REPO=https://github.com/jcschuster/ShotTx.git
ARG SHOT_REF=main

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates build-essential git \
    && rm -rf /var/lib/apt/lists/*

RUN mix local.hex --force && mix local.rebar --force

RUN git clone --depth 1 --branch "${SHOT_REF}" "${SHOT_REPO}" /opt/shot_tx
WORKDIR /opt/shot_tx
RUN mix deps.get && MIX_ENV=prod mix escript.build && \
    install -m 0755 shot_tx /usr/local/bin/shot_tx.bin && \
    /usr/local/bin/shot_tx.bin --version

# The escript shebang (`#!/usr/bin/env escript`) needs an Erlang runtime, so
# the runtime stage keeps the hexpm/elixir base.
FROM docker.io/hexpm/elixir:1.20.3-erlang-28.4.3-debian-bookworm-20260824-slim
COPY --from=builder /usr/local/bin/shot_tx.bin /usr/local/bin/shot_tx.bin

# Entrypoint wrapper: ShotTx refutes a conjecture, so a problem without one is
# run in `--sat` (satisfiability) mode. The real escript is shot_tx.bin.
RUN printf '%s\n' \
    '#!/bin/sh' \
    'file=""' \
    'for a in "$@"; do' \
    '  case "$a" in' \
    '    -*) ;;' \
    '    *) file="$a" ;;' \
    '  esac' \
    'done' \
    'if [ -n "$file" ] && [ -f "$file" ] && ! grep -qi "conjecture" "$file"; then' \
    '  exec /usr/local/bin/shot_tx.bin --sat "$@"' \
    'fi' \
    'exec /usr/local/bin/shot_tx.bin "$@"' \
    > /usr/local/bin/shot_tx \
    && chmod +x /usr/local/bin/shot_tx

ENTRYPOINT ["/usr/local/bin/shot_tx"]
